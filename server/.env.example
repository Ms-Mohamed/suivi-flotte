MONGODB_URI=mongodb://127.0.0.1:27017/suivi_flotte
PORT=4000
JWT_SECRET=dev-secret-change-me
# Créés au premier démarrage si aucun utilisateur n'existe (obligatoires en production)
ADMIN_EMAIL=admin@flotte.local
ADMIN_PASSWORD=admin1234
# Sauvegardes automatiques (quotidiennes, 30 conservées par défaut)
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP=30
